---
import { getCollection } from "astro:content";

import ReededSky from "@/components/ReededSky.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort((first, second) =>
  second.data.date.localeCompare(first.data.date),
);
---

<BaseLayout headerAsHeading>
  <ReededSky />

  <section aria-label="About">
    <p class="about">
      Hi, I'm Justin, a fourth-year CS student at UBC. I've previously interned
      at Amazon and Ciena where I worked on an error classification engine for
      accounting systems and AI agents for telecom and data center networks. I'm
      interested in AI, distributed systems, and developer tools. You can find
      my projects on{" "}
      <a
        href="https://github.com/justinli34"
        target="_blank"
        rel="noopener noreferrer"
        >GitHub</a
      >. Outside of coding, I like to make{" "}
      <a
        href="https://www.youtube.com/@justinli34"
        target="_blank"
        rel="noopener noreferrer"
        >music</a
      >, play tennis, and travel. Feel free to message me on{" "}
      <a
        href="https://www.linkedin.com/in/justinlibc"
        target="_blank"
        rel="noopener noreferrer"
        >LinkedIn</a
      >
      {" "}or{" "}
      <a
        href="https://x.com/justinlidev"
        target="_blank"
        rel="noopener noreferrer"
        >X</a
      >.
    </p>
  </section>

  <section class="posts" aria-label="Posts">
    <ul>
      {posts.map((post) => (
          <li>
            {post.data.date && (
              <time datetime={post.data.date}>{post.data.date}</time>
            )}
            <a href={`/blog/${encodeURIComponent(post.id)}`}>
              {post.data.title}
            </a>
          </li>
        ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .about {
    text-wrap: pretty;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }

  .posts ul {
    display: grid;
    gap: 0.25rem;
  }

  .posts li {
    display: flex;
    gap: 0.75rem;
  }

  .posts a {
    text-decoration-line: underline;
    text-decoration-color: transparent;
  }

  .posts a:hover {
    text-decoration-color: var(--color-fg);
  }
</style>
