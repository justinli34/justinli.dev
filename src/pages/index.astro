---
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";

const externalLinks = [
  ["LinkedIn", "https://www.linkedin.com/in/justinlibc"],
  ["GitHub", "https://github.com/justinli34"],
  ["X", "https://x.com/justinlidev"],
  ["YouTube", "https://www.youtube.com/@justinli34"],
] as const;

const posts = (await getCollection("blog")).sort((first, second) =>
  second.data.date.localeCompare(first.data.date),
);
---

<BaseLayout>
  <section class="links" aria-label="Links">
    <ul>
      {externalLinks.map(([label, href]) => (
          <li>
            <a href={href} target="_blank" rel="noopener noreferrer">
              {label}
            </a>
          </li>
        ))}
      <li>
        <a href="mailto:justin@justinli.dev">justin@justinli.dev</a>
      </li>
    </ul>
  </section>
  <section aria-label="About">
    <p class="about">
      Hi, I'm Justin, a fourth-year CS student at UBC. I've previously interned
      at Amazon and Ciena where I worked on an error classification engine for
      accounting systems and AI agents for telecommunication and data center
      networks. I'm interested in AI, distributed systems, and developer tools.
      Outside of coding, I like to make music, play tennis, travel, and research
      markets. I'm currently looking for full-time software engineering jobs.
    </p>
  </section>

  <section class="posts" aria-label="Posts">
    <ul>
      {posts.map((post) => (
          <li>
            {post.data.date && (
              <time datetime={post.data.date}>{post.data.date}</time>
            )}
            <a href={`/blog/${encodeURIComponent(post.id)}`}>
              {post.data.title}
            </a>
          </li>
        ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .about {
    text-wrap: pretty;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links ul {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1.125rem;
    row-gap: 0.25rem;
    font-size: 0.875rem;
  }

  .links a {
    display: inline-block;
    padding-block: 0.2rem;
    text-decoration-color: #afc4d570;
  }

  .links a:hover {
    text-decoration-color: var(--color-fg-strong);
  }

  .posts {
    margin-top: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid #c4d5e033;
  }

  .posts ul {
    display: grid;
    gap: 0.75rem;
  }

  .posts li {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .posts time {
    flex-shrink: 0;
  }

  .posts a {
    text-decoration-color: transparent;
  }

  .posts a:hover {
    text-decoration-color: var(--color-fg-strong);
  }

  @media (max-width: 480px) {
    .links li:last-child {
      flex-basis: 100%;
    }

    .posts li {
      gap: 1rem;
    }
  }
</style>
