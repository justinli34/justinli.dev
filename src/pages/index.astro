---
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/utils/date";

const posts = (await getCollection("blog")).sort((first, second) =>
  second.data.date.localeCompare(first.data.date),
);
---

<BaseLayout headerAsHeading>
  <section aria-label="About">
    <p>
      Hi, I'm Justin, a fourth-year CS student at UBC. I previously interned at
      Amazon, building an error classification engine for accounting systems,
      and at Ciena, developing AI agents for network observability. Outside of
      coding, I like to make music, play tennis, and travel. Feel free to
      message me on X or LinkedIn.
    </p>
  </section>

  <section class="posts" aria-label="Posts">
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/blog/${encodeURIComponent(post.id)}`}>{post.data.title}</a>
          {post.data.date && (
            <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
          )}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts ul {
    display: grid;
    gap: 1rem;
  }

  .posts li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .posts a {
    text-decoration: none;
  }
</style>
