<fieldset
  class="sky-window"
  aria-label="Reeded glass sky. Click a slice to toggle glass on or off, or hold and drag to paint multiple slices."
  hidden
>
  <canvas class="sky-canvas" aria-hidden="true"></canvas>
  <div class="sky-slices"></div>
  <div class="glass-edge" aria-hidden="true"></div>
</fieldset>

<script>
  import { initReededSky } from "./reeded-sky";

  document.addEventListener("astro:page-load", initReededSky);

  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      document.removeEventListener("astro:page-load", initReededSky);
    });
  }
</script>

<style>
  .sky-window {
    position: relative;
    min-width: 0;
    margin: 0;
    padding: 0;
    height: 200px;
    overflow: hidden;
    isolation: isolate;
    background: oklch(71% 0.064 214);
    border: 1px solid oklch(66% 0.047 203);
    border-radius: 3px;
  }

  .sky-canvas,
  .sky-slices,
  .glass-edge {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sky-canvas {
    display: block;
  }

  .sky-slices {
    display: flex;
    touch-action: none;
    user-select: none;
  }

  .sky-slices :global(button) {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: oklch(0 0 0 / 0);
    cursor: pointer;
  }

  .sky-slices :global(button:focus-visible) {
    outline: 2px solid oklch(1 0 0);
    outline-offset: -3px;
    box-shadow: inset 0 0 0 4px oklch(29% 0.051 247);
  }

  .glass-edge {
    pointer-events: none;
    border-radius: inherit;
    box-shadow:
      inset 0 1px 1px oklch(99% 0.016 197 / 69%),
      inset 0 -2px 3px oklch(31% 0.042 224 / 44%),
      inset 2px 0 3px oklch(98% 0.026 197 / 44%),
      inset -2px 0 3px oklch(31% 0.042 224 / 38%);
  }
</style>
