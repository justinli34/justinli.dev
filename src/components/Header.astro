---
const isHome = Astro.url.pathname === "/";
---

<header class="site-header">
  {isHome ? <h1>Justin Li</h1> : <a class="identity" href="/">Justin Li</a>}
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 64px 0 36px;
  }

  h1 {
    font-size: 40px;
    line-height: 1.2;
    letter-spacing: -0.05em;
  }

  .identity {
    color: var(--color-fg-strong);
    font-size: 16px;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .site-header {
      padding: 36px 0 28px;
    }

    h1 {
      font-size: 32px;
    }
  }
</style>
