---
type Props = {
  asHeading?: boolean;
};

const { asHeading = false } = Astro.props;
---

<header transition:name="site-header">
  {asHeading ? (
      <h1>
        <a href="/#home-content">Justin Li</a>
      </h1>
    ) : (
      <a href="/#home-content">Justin Li</a>
    )}
</header>

<style>
  h1 {
    font: inherit;
  }

  a {
    position: relative;
    display: inline-flex;
    font-size: 1.5rem;
    text-decoration: none;
  }
</style>
