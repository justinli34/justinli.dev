---
type Props = {
  asHeading?: boolean;
  sidebar?: boolean;
};

const { asHeading = false, sidebar = false } = Astro.props;

const links = [
  { label: "GitHub", href: "https://github.com/justinli34" },
  { label: "YouTube", href: "https://www.youtube.com/@justinli34" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/justinlibc" },
  { label: "X", href: "https://x.com/justinlidev" },
];
---

<header class:list={{ sidebar }}>
  {asHeading ? (
    <h1 class="name" transition:name="name" transition:animate="initial">
      Justin Li
    </h1>
  ) : (
    <p class="name" transition:name="name" transition:animate="initial">
      Justin Li
    </p>
  )}
  {sidebar ? (
    <a class="back" href="/">
      Back
    </a>
  ) : (
    <nav class="links" aria-label="Social links">
      {links.map(({ label, href }) => (
        <a href={href} target="_blank" rel="noopener noreferrer">
          {label}
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  )}
</header>

<style>
  header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .name {
    font-size: 1.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .links a,
  .back {
    color: var(--color-muted);
    text-decoration: none;
  }

  .links a:is(:hover, :focus-visible),
  .back:is(:hover, :focus-visible) {
    color: var(--color-fg);
  }

  @media (min-width: 68rem) {
    .sidebar {
      grid-column: 1;
      justify-self: end;
      width: 8rem;
      position: sticky;
      top: 4rem;
    }
  }
</style>
