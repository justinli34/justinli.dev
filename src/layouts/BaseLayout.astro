---
import { ClientRouter } from "astro:transitions";

import Header from "@/components/Header.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
  centered?: boolean;
  headerAsHeading?: boolean;
};

const {
  title = "Justin Li",
  centered = true,
  headerAsHeading = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400&display=swap"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter fallback="none" />
  </head>

  <body>
    <div class:list={["page", { centered }]}>
      <Header asHeading={headerAsHeading} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  :global(:root) {
    --header-transition-duration: 250ms;
  }

  :global(::view-transition-group(site-header)) {
    animation-duration: var(--header-transition-duration);
  }

  :global(::view-transition-new(root)) {
    animation-delay: var(--header-transition-duration);
    animation-fill-mode: both;
  }

  .page {
    display: flex;
    flex-direction: column;
    max-width: 700px;
    min-height: 100dvh;
    gap: 1rem;
    margin: 0 auto;
    padding: 4rem 2rem 2rem;
  }

  main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .page.centered {
      justify-content: center;
      padding: 2rem 2rem 8rem;
    }
  }
</style>
