---
import Header from "@/components/Header.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
};

const { title = "Justin Li" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <main>
      <Header />
      <slot />
    </main>
  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
    max-width: 700px;
    min-height: 100vh;
    gap: 1rem;
    margin: 0 auto;
    padding: 4rem 2rem 2rem;
  }
</style>
