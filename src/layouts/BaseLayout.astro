---
import { ClientRouter } from "astro:transitions";

import "@fontsource/open-runde/400.css";

import Header from "@/components/Header.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
  headerAsHeading?: boolean;
  sidebar?: boolean;
};

const {
  title = "Justin Li",
  headerAsHeading = false,
  sidebar = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter fallback="none" />
  </head>

  <body>
    <div class:list={["page", { sidebar }]}>
      <Header asHeading={headerAsHeading} sidebar={sidebar} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 43.75rem;
    /* Keep layout stable while mobile browser bars expand/collapse. */
    min-height: 100svh;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  @media (min-width: 40rem) {
    .page {
      padding: 4rem 2rem 2rem;
    }
  }

  main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Hang the header in the left gutter, keeping the content column where
     other pages put it. Only once the gutter fits it, scrollbar included. */
  @media (min-width: 68rem) {
    .sidebar {
      display: grid;
      grid-template-columns: 1fr minmax(0, calc(43.75rem - 4rem)) 1fr;
      align-items: baseline;
      gap: 0 3rem;
      max-width: none;
    }

    .sidebar main {
      grid-column: 2;
    }
  }
</style>
