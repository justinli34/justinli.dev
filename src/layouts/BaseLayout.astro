---
import Header from "@/components/Header.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Justin Li",
  description = "CS student at UBC. Interested in AI, distributed systems, and developer tools.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f9f6" />
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400&display=swap"
    />
    <title>{title}</title>
    <script>
      import "@/scripts/theme";
    </script>
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("justinli-theme");
        } catch {}
        const dark =
          saved === "dark" ||
          (saved !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.querySelector('meta[name="theme-color"]').content = dark
          ? "#111719"
          : "#f9f9f6";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <Header />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    width: min(var(--page-width), calc(100% - 112px));
    margin-inline: auto;
    padding-bottom: 64px;
  }

  main {
    min-width: 0;
  }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 10;
    padding: 8px 16px;
    transform: translateY(-160%);
    background: var(--color-bg);
    color: var(--color-fg-strong);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (max-width: 700px) {
    .page {
      width: min(var(--page-width), calc(100% - 48px));
    }
  }
</style>
