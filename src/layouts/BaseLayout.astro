---
import { ClientRouter } from "astro:transitions";

import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
  headerAsHeading?: boolean;
};

const { title = "Justin Li", headerAsHeading = false } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400&display=swap"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter fallback="none" />
  </head>

  <body>
    <div class="page">
      <Header asHeading={headerAsHeading} />
      <main>
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    /* Keep layout stable while mobile browser bars expand/collapse. */
    min-height: 100svh;
  }

  .page {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 2rem;
    max-width: 700px;
    /* Center against the viewport (100vw includes the scrollbar) so the column
       doesn't shift between pages with and without a scrollbar. Unlike
       scrollbar-gutter, this lets the footer span the full width. */
    margin-left: max(0px, (100vw - 700px) / 2);
    padding: 4rem 2rem 2rem;
  }

  main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
</style>
